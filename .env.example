# Google Gemini configuration for AI outfit recommendations.
GEMINI_API_KEY=your_gemini_api_key_here

# Currently recommended Gemini model (structured output supported).
GEMINI_MODEL=gemini-3.5-flash-lite

# Stripe Checkout. Use a test secret key for local development.
STRIPE_SECRET_KEY=
APP_BASE_URL=http://localhost/phpGroupProject/public

# Optional. Defaults to the current Gemini v1beta endpoint.