# Google Gemini configuration for AI outfit recommendations.
# Copy this file to .env and add your own key. Never commit .env.

GEMINI_API_KEY=your_gemini_api_key_here

# Currently recommended Gemini model (structured output supported).
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Defaults to the current Gemini v1beta endpoint.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Optional. Request timeout in seconds (5-60).
# GEMINI_TIMEOUT=30
